# Copy this file to .env and adjust the values.

# PostgreSQL connection via Docker (matches docker-compose.yml port 5433)
DATABASE_URL=postgres://dibantu:dibantu@127.0.0.1:5433/dibantudigital

# Public base URL of the app (used for links in emails, OAuth redirects, payment callbacks)
APP_URL=http://localhost:3000

# 32-byte key (base64) used to encrypt Meta access tokens at rest.
# WAJIB generate sendiri & jangan pernah dibagikan / di-commit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PENTING: jika key ini diganti, semua token Meta tersimpan harus dihubungkan ulang.
ENCRYPTION_KEY=

# Meta App (developers.facebook.com -> My Apps -> App settings -> Basic)
# Dengan META_APP_SECRET, setiap request ditandatangani appsecret_proof sehingga
# token yang bocor tidak bisa dipakai dari luar server ini.
META_APP_ID=
META_APP_SECRET=
# (Aplikasi tipe Bisnis) ID Konfigurasi dari Facebook Login for Business -> Konfigurasi.
# Jika diisi, login memakai config_id (bukan scope).
META_LOGIN_CONFIG_ID=

# Google OAuth 2.0 (console.cloud.google.com -> APIs & Services -> Credentials)
# Authorized redirect URI: https://dibantudigital.id/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Pengiriman Verifikasi & Reset Password (pilih salah satu: Resend API atau SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DibantuDigital <noreply@dibantudigital.id>"

# Number of free-trial days given to a new workspace
TRIAL_DAYS=7
